{
  "name": "@altamkp/dsh-plugin",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "altamkp's personal plugin collection for DeepSeek Harness — personal tweaks and tools maintained by altamkp",
  "exports": {
    ".": "./index.js",
    "./default-permission": "./default-permission/index.js",
    "./default-permission/locale/*.json": "./locale/default-permission/*.json",
    "./default-permission/icon": "./icon.svg",
    "./notifications": "./notifications/index.js",
    "./notifications/locale/*.json": "./locale/notifications/*.json",
    "./notifications/icon": "./notifications/icon.svg",
    "./chat-width": "./chat-width/index.js",
    "./chat-width/client": "./chat-width/client.js",
    "./chat-width/locale/*.json": "./locale/chat-width/*.json",
    "./chat-width/icon": "./chat-width/icon.svg",
    "./client": "./chat-width/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "default-permission/index.js",
    "default-permission/package.json",
    "notifications/index.js",
    "notifications/notify.js",
    "notifications/windows.js",
    "notifications/icon.svg",
    "notifications/package.json",
    "chat-width/index.js",
    "chat-width/client.js",
    "chat-width/icon.svg",
    "chat-width/package.json",
    "cordis.patch.yml",
    "locale/*.json",
    "locale/default-permission/*.json",
    "locale/notifications/*.json",
    "locale/chat-width/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
